# Values are deliberately empty. Keep completed config and credentials private.
FV_APNS_KEY_PATH=
FV_APNS_KEY_ID=
FV_APPLE_TEAM_ID=
FV_BUNDLE_ID=org.example.voicestack
# Own-client directory (defaults to ios/private/openchamber). Deployment preflight
# requires its private client.json plus matching identity.json; absent is NOT ready.
# FV_OC_CLIENT_DIR=/absolute/private/operator/chosen/path
# Separate reviewed Agent Canvas source with its installed dependencies:
FV_AGENT_CANVAS_SOURCE=
# Nonsecret install policy: empty denies. Keep these equal to native generation.
FV_INSTALL_DEPLOYMENT_SUFFIX=
FV_APPROVED_INSTALL_MANIFESTS=[]
